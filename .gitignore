# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runtime state — uploads spool here, results are written here.
# Neither belongs in the repo: uploads are user data, results are regenerable.
var/
uploads/
# Generated and recorded video stays out of the repo. The synthetic clips are
# fully reproducible from tools/make_synthetic.py with its fixed seed, so
# committing 40MB of derivable mp4 buys nothing; phone clips are just large.
*.mp4
*.mov
*.avi
samples/*.truth.json

# Generated measurement output. The README table is committed by hand,
# the raw sweep JSON is not.
out/
sweep-*.json

# OS
.DS_Store

# Secrets and local configuration. Nothing matching these is in the repo today;
# the rules exist so that a deploy key or an .env dropped into the working tree
# cannot be swept in by `git add -A`. A private key committed once is in the
# history permanently, and rewriting history is the only way back out.
*.pem
*.key
id_rsa*
.env
.env.local

# Runtime state, if a deployment ever writes here rather than to var/.
data/
